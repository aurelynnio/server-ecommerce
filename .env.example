# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=production
TRUST_PROXY=true
EXPOSE_ERROR_DETAILS=false

# CORS & Client Integration
FRONTEND_URL=https://nantianshop.tech
FRONTEND_URLS=https://nantianshop.tech,https://www.nantianshop.tech

# Security & Authentication (JWT)
# Generate 256-bit secrets via: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=16d
BCRYPT_SALT_ROUNDS=10

# Database (MongoDB)
MONGODB_URI=mongodb://admin:your_mongo_password@mongodb:27017/ecommerce?authSource=admin
MONGO_MAX_POOL_SIZE=25
MONGO_MAX_CONNECTING=5

# Redis (Cache, Sessions, Rate Limiting & Socket.IO Adapter)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
SOCKET_REDIS_ADAPTER=true

# RabbitMQ (Event-Driven Outbox & Queue Workers)
RABBITMQ_URL=amqp://admin:your_rabbit_password@rabbitmq:5672
RABBITMQ_EXCHANGE=app.topic
RABBITMQ_DLX=app.topic.dlx
START_QUEUE_WORKERS=true
ORDER_WORKER_PREFETCH=50
ORDER_DLQ_PREFETCH=10
NOTIFICATION_WORKER_PREFETCH=50
NOTIFICATION_DLQ_PREFETCH=10

# Node.js Cluster & Scheduler Configuration
ENABLE_CLUSTER=true
WEB_CONCURRENCY=2
ENABLE_SCHEDULER=true

# Rate Limiting & Access Logging
DISABLE_RATE_LIMIT=false
MORGAN_ENABLED=true
MORGAN_FORMAT=combined

# Order Processing Behavior
# When false: Standard checkout returns 201 Created synchronously with order details
# When true: All checkouts return 202 Accepted with trackingId for load testing
ASYNC_ORDER_INGESTION=false

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Assistant (Mistral AI)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=open-mistral-nemo

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Nantian Shop" <noreply@nantianshop.tech>
EMAIL_BASE_URL=https://nantianshop.tech

# Payment Gateway (VNPay Sandbox / Production)
SERVER_URL=https://api.nantianshop.tech
VNP_TMNCODE=your_vnpay_tmncode
VNP_HASHSECRET=your_vnpay_hashsecret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://nantianshop.tech/payment/vnpay-return
